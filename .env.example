# Copy to .env and change every value before deploying.
POSTGRES_USER=kpi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kpi

# Host port for connecting pgAdmin to the database (localhost only).
# Change it if 5432 is already used on your machine.
DB_PORT=5432

# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# First administrator, created automatically when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Administrator

# Port the web UI is published on.
WEB_PORT=8080
